def glyphs(L, r0, r1, gap=2):
    cols_used = sorted({c for r in range(r0,r1+1) for c,ch in enumerate(L[r]) if ch=='B'})
    if not cols_used: return []
    groups=[]; cur=[cols_used[0]]
    for c in cols_used[1:]:
        if c-cur[-1]<=gap: cur.append(c)
        else: groups.append(cur); cur=[c]
    groups.append(cur)
    return [tuple(''.join('B' if L[r][c]=='B' else '.' for c in range(g[0],g[-1]+1)) for r in range(r0,r1+1)) for g in groups]


def pink_glyphs(L):
    rows=range(52,57)
    cols_used=sorted({c for r in rows for c,ch in enumerate(L[r]) if ch=='B'})
    groups=[]; cur=[cols_used[0]]
    for c in cols_used[1:]:
        if c-cur[-1]<=2: cur.append(c)
        else: groups.append(cur); cur=[c]
    groups.append(cur)
    return [(g[0],g[-1],tuple(''.join('B' if L[r][c]=='B' else '.' for c in range(g[0],g[-1]+1)) for r in rows)) for g in groups]

def cursor(L):
    for r in range(46,51):
        cs=[c for c,ch in enumerate(L[r]) if ch=='W']
        if cs: return (r,min(cs),max(cs))
    return None

prev=None
for i,h in enumerate(history):
    L=h.frame.ascii.split('\n')
    pg=pink_glyphs(L); cur=cursor(L)
    key=(tuple(g[2] for g in pg), cur)
    if key!=prev:
        print(i, h.action, "cur",cur, [g[2][0] for g in pg])
        prev=key

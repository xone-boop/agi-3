<parameter=code>
def cartstate(frame):
    L=frame.ascii.split('\n')
    # find b/S cells in track rows 18-23
    cells=[]
    for r in range(18,24):
        for c in range(22,44):
            if L[r][c] in 'bS':
                cells.append((r,c,L[r][c]))
    if not cells: return None
    rs=[c[0] for c in cells]; cs=[c[1] for c in cells]
    r0,r1,c0,c1=min(rs),max(rs),min(cs),max(cs)
    # build matrix
    m={}
    for r,c,v in cells: m[(r,c)]=v
    rows=[]
    for r in range(r0,r1+1):
        row=''
        for c in range(c0,c1+1):
            row+=m.get((r,c),'.')
        rows.append(row)
    return (r0,c0,r1,c1,rows)
prev=None
for i,t in enumerate(transitions):
    cb=cartstate(t.before_frame); ca=cartstate(t.after_frame)
    def fmt(x):
        if not x: return 'None'
        r0,c0,r1,c1,rows=x
        return f"({r0},{c0})-({r1},{c1}) "+'/'.join(rows)
    mark=' *CART*' if cb!=ca else ''
    print(i, t.action[:12], fmt(ca), mark)
</parameter>
</function>

def fill(frame):
    L=frame.ascii.split('\n')
    # find cart bbox via b/S
    cells=[(r,c) for r in range(18,24) for c in range(22,44) if L[r][c] in 'bS']
    if not cells: return None
    rs=[x[0] for x in cells]; cs=[x[1] for x in cells]
    r0,r1,c0,c1=min(rs),max(rs),min(cs),max(cs)

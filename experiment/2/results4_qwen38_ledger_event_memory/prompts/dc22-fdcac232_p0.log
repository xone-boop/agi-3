        if n['color'] in ('N','R','b','Y') and n['pixels']>=4:
            b=n['boundary']; bb=[min(p[0] for p in b),max(p[0] for p in b),min(p[1] for p in b),max(p[1] for p in b)]
            out.setdefault(n['color'],[]).append(tuple(bb))
    return out

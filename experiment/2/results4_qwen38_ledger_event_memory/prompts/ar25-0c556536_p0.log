def shape(f,col):
    a=f.ascii.split('\n')
    pts=[(r,c) for r in range(1,63) for c in range(1,63) if a[r][c]==col]
    if not pts: return None
    r0=min(r for r,_ in pts); c0=min(c for _,c in pts)
    return frozenset((r-r0,c-c0) for r,c in pts)
def bbox(f,col):
    a=f.ascii.split('\n')
    pts=[(r,c) for r in range(1,63) for c in range(1,63) if a[r][c]==col]
    if not pts: return None
    return (min(r for r,_ in pts),max(r for r,_ in pts),min(c for _,c in pts),max(c for _,c in pts),len(pts))
frames={t.after_frame.step:t.after_frame for t in transitions}

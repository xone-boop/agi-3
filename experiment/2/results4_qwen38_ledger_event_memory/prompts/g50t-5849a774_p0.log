def token_bbox(frame):
    for n in frame.segmentation['nodes']:
        if n['color']=='b' and 20<=n['pixels']<=30:
            rs=[p[0] for p in n['boundary']]; cs=[p[1] for p in n['boundary']]
            return (min(rs),min(cs),max(rs),max(cs))
    return None
print("step | action | token_bbox")
prev=None
for i,h in enumerate(history):
    tb=token_bbox(h.frame)
    print(f"{h.frame.step:3d} | {str(h.action)[:30]:30s} | {tb}")

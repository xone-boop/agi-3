def water(fr):
    for n in fr.segmentation['nodes']:
        if n['color']=='S' and n['pixels']>100:
            return set()
    # return pixel set via ascii
    px=set()
    for r,line in enumerate(fr.ascii.split('\n')):
        for c,ch in enumerate(line):
            if ch=='S': px.add((r,c))
    return px
def rope_crosses(p1,p2,wset):
    # sample line from p1 to p2
    import math
    (r1,c1),(r2,c2)=p1,p2
    steps=200
    for i in range(steps+1):
        r=r1+(r2-r1)*i/steps; c=c1+(c2-c1)*i/steps
        for dr in (-1,0,1):
            for dc in (-1,0,1):
                if (round(r)+dr,round(c)+dc) in wset: return (round(r),round(c))
    return None

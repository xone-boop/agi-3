def diamond(frame,ch):
    x=frame.ascii.split('\n')
    ps=[(i,j) for i in range(len(x)) for j in range(2,len(x[i])) if x[i][j]==ch]
    if not ps: return None
    return (round(sum(i for i,j in ps)/len(ps)),round(sum(j for i,j in ps)/len(ps)))

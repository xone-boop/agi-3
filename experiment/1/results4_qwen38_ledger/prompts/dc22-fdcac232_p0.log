import json
def pieces(f):
    d={}
    for n in f.segmentation['nodes']:
        rs=[p[0] for p in n['boundary']]; cs=[p[1] for p in n['boundary']]
        r,c,px=min(rs),min(cs),n['pixels']
        if c>30:  # right panel
            continue
        if px>=8:  # ignore tiny checker subpixels & bg
            d[(n['color'],r,c)]=px
    return d
print("CURRENT left pieces:")

import json
def ball(f,c='N'):
    for n in f.segmentation['nodes']:
        if n['color']==c:
            rs=[p[0] for p in n['boundary']]; cs=[p[1] for p in n['boundary']]
            return (min(rs),min(cs))
def res():
    r=last_action_result
    return dict(bc=r.get('board_changed'),done=r.get('done'),lc=r.get('level_completed'),go=r.get('game_over'),rw=r.get('reward'))

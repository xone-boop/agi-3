def count_n(nodes): return sum(1 for n in nodes if n['color']=='N' and n['pixels']>10)
def get_b(nodes):
    for n in nodes:
        if n['color']=='b' and n['pixels']>3:
            b=n['boundary']
            return (min(p[0] for p in b), min(p[1] for p in b))
    return None
def get_greens(nodes):
    out=[]
    for n in nodes:
        if n['color']=='N' and n['pixels']>10:
            b=n['boundary']
            rows=[p[0] for p in b]; cols=[p[1] for p in b]
            out.append((min(rows), min(cols), max(rows), max(cols)))
    return sorted(out)


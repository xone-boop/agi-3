def blk(frame):
    d={}
    for n in frame.segmentation['nodes']:
        if n['color'] in ('R','b','N'):
            rows=[p[0] for p in n['boundary']]; cols=[p[1] for p in n['boundary']]
            if min(rows)<45:
                d[n['color']]=(min(rows),max(rows),min(cols),max(cols))
    return d
def player(frame):
    for n in frame.segmentation['nodes']:
        if n['color']=='M' and n['pixels']>10:
            rows=[p[0] for p in n['boundary']]; cols=[p[1] for p in n['boundary']]
            return (min(rows),max(rows),min(cols),max(cols))
    return None
# arm: find thin vertical gray node in play area (cols 17-46, rows 12-41)
def arm(frame):
    cands=[]

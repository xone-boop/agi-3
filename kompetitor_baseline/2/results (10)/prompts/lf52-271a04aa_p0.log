def gempos(frame):
    out=[]
    for n in frame.segmentation['nodes']:
        if n['color']=='N' and n['pixels']>=10:
            b=n['boundary'];out.append((min(p[0] for p in b),min(p[1] for p in b)))
    return sorted(out)
def darkpos(frame):
    out=[]
    for n in frame.segmentation['nodes']:
        if n['color']=='G' and 10<=n['pixels']<=30:
            b=n['boundary'];out.append((min(p[0] for p in b),min(p[1] for p in b)))
    return sorted(out)

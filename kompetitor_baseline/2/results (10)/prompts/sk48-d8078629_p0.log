def cells(f):
    return [l.ljust(64,' ') for l in f.ascii.split('\n')]
def diff(t):
    a=cells(t.before_frame); b=cells(t.after_frame)
    ch=[]
    for r in range(16,36):
        for c in range(16,48):
            if a[r][c]!=b[r][c]:
                ch.append((r,c,a[r][c],b[r][c]))
    return ch

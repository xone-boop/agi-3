    a=fr.ascii.split('\n');R=len(a);C=len(a[0]);seen=[[False]*C for _ in range(R)]
    out=[]
    for r in range(R):
        for c in range(C):
            if a[r][c]=='B' and not seen[r][c]:
                q=__import__('collections').deque([(r,c)]);seen[r][c]=True;px=[]
                while q:
                    y,x=q.popleft();px.append((y,x))
                    for dy,dx in((1,0),(-1,0),(0,1),(0,-1)):
                        ny,nx=y+dy,x+dx
                        if 0<=ny<R and 0<=nx<C and a[ny][nx]=='B' and not seen[ny][nx]:
                            seen[ny][nx]=True;q.append((ny,nx))
                if len(px)>=6:
                    ys=[p[0] for p in px];xs=[p[1] for p in px]
                    out.append((min(ys),min(xs),px))
    return out
def grid5(comp):
    r0,c0,px=comp
    g=[['.']*5 for _ in range(5)]
    for y,x in px:
        if 0<=y-r0<5 and 0<=x-c0<5: g[y-r0][x-c0]='#'
    return ''.join(''.join(row) for row in g)
cs=sorted(comps(current_frame))
topB={};botB={};botP={}
for comp in cs:
    r0,c0=comp[0],comp[1]
    if r0<32:
        rb=0 if r0<12 else (1 if r0<21 else 2)
        side='L' if c0<30 else 'R'
        kind='B' if (12<=c0<20 or 35<=c0<43) else 'P'
        if kind=='B': topB[f"r{rb}{side}"]=grid5(comp)
    else:
        band='B' if r0<50 else 'P'; idx=(c0-15)//7
        (botB if band=='B' else botP)[idx]=grid5(comp)
def ham(a,b): return sum(1 for i in range(25) if a[i]!=b[i])
print("Bottom blue vs top blue (best match, hamming):")
for i in range(5):
    d=sorted(((ham(botB[i],t),k) for k,t in topB.items()))
    print(f"  botB{i}: best={d[0][1]}(d={d[0][0]})  all={[(k,v) for v,k in d]}")
print("\nBottom pink vs top pink (best match):")
topP={}
for comp in cs:
    r0,c0=comp[0],comp[1]
    if r0<32 and (22<=c0<30 or 45<=c0<53):
        rb=0 if r0<12 else (1 if r0<21 else 2)
        side='L' if c0<40 else 'R'

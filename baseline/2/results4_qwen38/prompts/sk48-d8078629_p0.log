def snap(fr):
    seg=fr.segmentation
    tg={n['color']:(min(p[0] for p in n['boundary']),min(p[1] for p in n['boundary']),max(p[1] for p in n['boundary'])) for n in seg['nodes'] if n['color'] in ('R','b','N') and n['pixels']==16 and n['boundary'][0][0]<50}
    w=[n for n in seg['nodes'] if n['color']=='w' and n['pixels']<=4 and n['boundary'][0][0]<50]
    tip=max(max(q[1] for q in n['boundary']) for n in w) if w else None
    beam=sorted(set(q[0] for n in w for q in n['boundary']))
    pl=None
    for n in seg['nodes']:
        if n['color']=='M' and n['pixels']>=20 and n['boundary'][0][0]<50:
            pl=(min(p[0] for p in n['boundary']),max(p[0] for p in n['boundary']))
    return (tip,beam,pl,tuple(sorted(tg.items())))
for i,t in enumerate(transitions):
    b=snap(t.before_frame); a=snap(t.after_frame)
    print(i, t.action, 'B:',b[0],b[1],b[2],b[3])
    print('   A:',a[0],a[1],a[2],a[3])

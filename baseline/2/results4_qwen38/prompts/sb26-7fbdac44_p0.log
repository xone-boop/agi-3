# Exact diffs for last 8 transitions
def grid(f):
    return f.ascii.split('\n')
for t in transitions[-8:]:
    a=grid(t.before_frame); b=grid(t.after_frame)
    diffs=[]
    for r in range(min(len(a),len(b))):
        for c in range(min(len(a[r]),len(b[r]))):
            if a[r][c]!=b[r][c]:
                diffs.append((r,c,a[r][c],b[r][c]))
    print("step",t.after_frame.step,t.action,"| changed",len(diffs))
    if diffs:
        # summarize by region
        for d in diffs[:40]:
            print("   ",d)

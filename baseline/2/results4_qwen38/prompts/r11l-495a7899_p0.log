def state(f):
    st=None; gs=[]; gem=None; sq=None
    for n in f.segmentation['nodes']:
        c=n['color']; b=n['boundary']; rs=[x[0] for x in b]; cs=[x[1] for x in b]
        cy=(min(rs)+max(rs))//2; cx=(min(cs)+max(cs))//2
        if c=='W' and n['pixels']<20: st=(cy,cx)
        elif c=='G' and n['pixels']<20: gs.append((cy,cx))
        elif c=='O' and n['pixels']==20: gem=(cy,cx)
        elif c=='p' and n['pixels']==20: sq=(cy,cx)
    return st,sorted(gs),gem,sq

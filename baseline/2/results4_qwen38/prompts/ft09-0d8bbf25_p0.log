def board_of(fr):
    a=fr.ascii.split('\n')
    rows=[12,20,28,36,44,52]; cols=[12,20,28,36,44]
    b={}
    for ri,r in enumerate(rows):
        for ci,c in enumerate(cols):
            b[(ri,ci)]=a[r+3][c+3]
    return b
def cell_of(px,py):
    r=(px-15)//8; c=(py-15)//8
    return (r,c)
prev=board_of(history[12].frame)
for i in range(13,56):
    h=history[i]
    if h.frame.level!=3: break
    b=board_of(h.frame)
    d={k:(prev[k],b[k]) for k in b if prev.get(k)!=b.get(k)}
    act=h.action
    import re
    m=re.search(r'row=(\d+), col=(\d+)',act)
    click=cell_of(int(m.group(1)),int(m.group(2)))
    print(i,click,{k:v for k,v in d.items()})
    prev=b
</parameter>
